# Neon 数据库连接（连接池，用于应用）
DATABASE_URL="postgresql://neondb_owner:[YOUR-PASSWORD]@[YOUR-PROJECT]-pooler.[YOUR-REGION].aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon 数据库直连（用于 Prisma 迁移）
DIRECT_URL="postgresql://neondb_owner:[YOUR-PASSWORD]@[YOUR-PROJECT].[YOUR-REGION].aws.neon.tech/neondb?sslmode=require"

# Neon Managed Better Auth
NEON_AUTH_BASE_URL="https://[YOUR-PROJECT].neonauth.[YOUR-REGION].aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="[YOUR-COOKIE-SECRET-AT-LEAST-32-CHARS]"

# Cloudflare Turnstile 人机验证
# 测试用 Site Key（始终通过）：1x00000000000000000000AA
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# 测试用 Secret Key（始终通过）：1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# AI 接口
AI_API_KEY="[YOUR-AI-API-KEY]"
AI_BASE_URL="https://api.deepseek.com"
AI_MODEL="deepseek-chat"